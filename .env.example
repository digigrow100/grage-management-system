# Supabase project connection (public/anon key only — safe to expose client-side).
# Get these from your Supabase project: Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DVLA Vehicle Enquiry Service — server-only, never expose to the client.
# Register at https://developer-portal.driver-vehicle-licensing.api.gov.uk/
# Leaving this unset disables vehicle lookup; manual vehicle entry still works.
DVLA_API_KEY=

# Google Maps / Places Autocomplete (New) — browser key is restricted by
# HTTP referrer + the Places API in Google Cloud Console; it's still public
# by design (that's how Maps JS keys work), so restrict it there rather than
# treating it as a secret. Leaving it unset disables address autocomplete;
# manual address entry still works.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Reserved for server-side-only Google APIs (e.g. Address Validation) if
# enabled later. Not used by the Phase 1 autocomplete component.
GOOGLE_MAPS_SERVER_KEY=
